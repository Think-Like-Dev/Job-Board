# AI service
AI_APP_NAME=AI Platform API
AI_ENVIRONMENT=local
AI_LOG_LEVEL=INFO
AI_API_V1_PREFIX=/api/v1

# Own database (separate Postgres instance, pgvector image).
# Inside Compose: host=ai-postgres, port=5432. From the host: localhost:5433.
AI_DATABASE_HOST=localhost
AI_DATABASE_PORT=5433
AI_DATABASE_USER=jobboard
AI_DATABASE_PASSWORD=change-me
AI_DATABASE_NAME=job_board_ai_ats
# Bare DATABASE_* names still work as a fallback (they are what the core API uses).
# Optional full override:
# AI_DATABASE_URL=postgresql+asyncpg://jobboard:change-me@localhost:5433/job_board_ai_ats

# 32 random bytes, urlsafe base64:
# python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AI_ENCRYPTION_KEY=
# Shared secret sent by the core API in the X-Internal-Token header
AI_INTERNAL_TOKEN=

AI_HTTP_TIMEOUT_SECONDS=30
AI_MAX_FALLBACK_SECONDS=45
AI_EMBEDDING_MODEL=text-embedding-3-small
# Vector size is fixed at 1536 by the schema; change both together only via a migration.
AI_MAX_RESUME_BYTES=10485760
AI_MIN_RESUME_TEXT_CHARS=200
AI_MAX_TEXT_CHARS=50000
AI_MAX_EMBEDDING_CHARS=24000

# --- Embedding model (swappable) ---------------------------------------------
# The local embedding model and its vector size. Changing the size also needs
# an Alembic migration (ALTER COLUMN ... TYPE vector(N) + rebuild the HNSW
# index) and a re-embed via `app/scripts/convert_embeddings.py`.
# multilingual-e5-small: 384 dimensions, 100 languages.
# The name doubles as the cache key for stored vectors: after swapping the
# GGUF file, change it too, or the old vectors keep being reused.
AI_LOCAL_EMBEDDING_MODEL=multilingual-e5-small-xlmr
AI_EMBEDDING_DIM=384
# The local server that serves the embeddings (OpenAI-compatible). Leave empty
# to use a stored OpenAI credential instead. The default matches the llama.cpp
# server started by scripts/start-llama-servers.ps1 (or .sh).
AI_EMBEDDING_BASE_URL=http://localhost:9932/v1
# E5-style models expect an asymmetric prefix: the job description is a query,
# the resume passages are passages.
AI_EMBEDDING_QUERY_PREFIX=query: 
AI_EMBEDDING_PASSAGE_PREFIX=passage: 

# --- OCR (Tesseract) ----------------------------------------------------------
# The Tesseract language packs installed in the image. English only for now;
# adding a language means installing its pack (see the README).
AI_OCR_LANGUAGES=eng
# A page with fewer characters than this is treated as image-only and OCR'd.
AI_OCR_PAGE_CHAR_THRESHOLD=40

# --- Local chat model (OpenAI-compatible, no API key) -------------------------
# The model server runs on the host. From inside Docker use
# http://host.docker.internal:<port>/v1; from the host http://localhost:<port>/v1
# The defaults match the llama.cpp servers started by
# scripts/start-llama-servers.ps1 (or .sh).
AI_LOCAL_LLM_BASE_URL=http://localhost:9931/v1
AI_LOCAL_LLM_MODEL=local-chat
AI_LOCAL_LLM_API_KEY=

# --- Object storage (Garage S3) -----------------------------------------------
# The bare S3_* names are read as a fallback so this service can share one env
# file with the core API; AI_STORAGE_* wins when set.
AI_STORAGE_ENDPOINT=http://localhost:3900
AI_STORAGE_REGION=garage
AI_STORAGE_ACCESS_KEY_ID=
AI_STORAGE_SECRET_ACCESS_KEY=
AI_STORAGE_BUCKET=jobboard-files
AI_STORAGE_FORCE_PATH_STYLE=true

# --- RabbitMQ ----------------------------------------------------------------
# The bare RABBITMQ_* names are read as a fallback; AI_RABBITMQ_* wins.
AI_RABBITMQ_HOST=localhost
AI_RABBITMQ_PORT=5672
AI_RABBITMQ_USER=jobboard
AI_RABBITMQ_PASSWORD=jobboard
AI_RABBITMQ_VHOST=/
