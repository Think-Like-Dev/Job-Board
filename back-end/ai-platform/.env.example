# AI service
AI_APP_NAME=AI Platform API
AI_ENVIRONMENT=local
AI_LOG_LEVEL=INFO
AI_API_V1_PREFIX=/api/v1

# Own database (separate Postgres instance, pgvector image).
# Inside Compose: host=ai-postgres, port=5432. From the host: localhost:5433.
AI_DATABASE_HOST=localhost
AI_DATABASE_PORT=5433
AI_DATABASE_USER=jobboard
AI_DATABASE_PASSWORD=change-me
AI_DATABASE_NAME=job_board_ai_ats
# Bare DATABASE_* names still work as a fallback (they are what the core API uses).
# Optional full override:
# AI_DATABASE_URL=postgresql+asyncpg://jobboard:change-me@localhost:5433/job_board_ai_ats

# 32 random bytes, urlsafe base64:
# python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AI_ENCRYPTION_KEY=
# Shared secret sent by the core API in the X-Internal-Token header
AI_INTERNAL_TOKEN=

AI_HTTP_TIMEOUT_SECONDS=30
AI_MAX_FALLBACK_SECONDS=45
AI_EMBEDDING_MODEL=text-embedding-3-small
# Vector size is fixed at 1536 by the schema; change both together only via a migration.
AI_MAX_RESUME_BYTES=10485760
AI_MIN_RESUME_TEXT_CHARS=200
AI_MAX_TEXT_CHARS=50000
AI_MAX_EMBEDDING_CHARS=24000
