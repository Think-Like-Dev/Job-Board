# Dev image: deps baked in, source bind-mounted by compose, uvicorn --reload.
# Same idea as platform-api's Dockerfile.dev, with the venv in a named volume.

FROM python:3.14-slim

# shortcut: unpinned uv image, pin the tag once the build is proven
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

# Tesseract for scanned (image-only) pages. Only the English language pack is
# installed; see the README for adding another language.
# curl is not used by the app - it is there so an operator can probe the host
# model servers from inside this container (`host.docker.internal:9931`), which
# is the only place that name resolves. A slim image has no curl.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        tesseract-ocr \
        tesseract-ocr-eng \
        libgl1 \
        libglib2.0-0 \
        curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock ./

# Dev group included here (ruff), unlike the production Dockerfile.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen

COPY . .

EXPOSE 8000
