# Local development template.
# `dk setup` copies this to env/.env.local if that file does not exist yet.
# Never put real secrets in this file — it is committed.

NODE_ENV=local

PORT=5000
API_PREFIX=api
LOG_LEVEL=debug

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=jobboard
DATABASE_PASSWORD=jobboard
DATABASE_NAME=job_board

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=jobboard:

SESSION_EXPIRY_MINUTES=10080

OTP_EXPIRY_SECONDS=300
# Fixed OTP is only honoured when NODE_ENV=local.
DEV_FIXED_OTP=123456

SESSION_COOKIE_NAME=session_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Lets `docker compose --env-file ./env/.env.local <cmd>` find the stack
# without -f flags. Windows/Git Bash uses ";" as the path separator.
COMPOSE_FILE="infrastructure/docker/compose.yml;infrastructure/docker/compose.local.yml"

# --- Object storage (Garage S3, local dev) -----------------------------------
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_ACCESS_KEY_ID=GK0123456789abcdef01234567
S3_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
S3_BUCKET_NAME=jobboard-files
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_EXPIRY_SECONDS=900

# --- AI platform -------------------------------------------------------------
AI_APP_NAME=AI Platform API
AI_ENVIRONMENT=local
AI_LOG_LEVEL=INFO
AI_API_V1_PREFIX=/api/v1

# Own Postgres instance (pgvector). Host port 5433 is mapped to 5432.
AI_DATABASE_HOST=ai-postgres
AI_DATABASE_PORT=5432
AI_DATABASE_USER=jobboard
AI_DATABASE_PASSWORD=jobboard
AI_DATABASE_NAME=job_board_ai_ats

# 32 random bytes, urlsafe base64 (needed only for BYOK provider credentials):
# python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AI_ENCRYPTION_KEY=
# Shared secret the core API sends in X-Internal-Token; must match on both sides.
AI_INTERNAL_TOKEN=

# --- RabbitMQ (shared broker) ------------------------------------------------
RABBITMQ_USER=jobboard
RABBITMQ_PASSWORD=jobboard
RABBITMQ_VHOST=/
# Inside Compose the host is the service name; both APIs read these.
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
