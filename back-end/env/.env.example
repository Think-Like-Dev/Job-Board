# Local development template.
# `dk setup` copies this to env/.env.local if that file does not exist yet.
# Never put real secrets in this file — it is committed.

NODE_ENV=local

PORT=5000
API_PREFIX=api
LOG_LEVEL=debug

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=jobboard
DATABASE_PASSWORD=jobboard
DATABASE_NAME=job_board

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=jobboard:

SESSION_EXPIRY_MINUTES=10080

OTP_EXPIRY_SECONDS=300
# Fixed OTP is only honoured when NODE_ENV=local.
DEV_FIXED_OTP=123456

SESSION_COOKIE_NAME=session_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Lets `docker compose --env-file ./env/.env.local <cmd>` find the stack
# without -f flags. Windows/Git Bash uses ";" as the path separator.
COMPOSE_FILE="infrastructure/docker/compose.yml;infrastructure/docker/compose.local.yml"

# --- Object storage (Garage S3, local dev) -----------------------------------
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_ACCESS_KEY_ID=GK0123456789abcdef01234567
S3_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
S3_BUCKET_NAME=jobboard-files
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_EXPIRY_SECONDS=900

# --- AI platform -------------------------------------------------------------
AI_APP_NAME=AI Platform API
AI_ENVIRONMENT=local
AI_LOG_LEVEL=INFO
AI_API_V1_PREFIX=/api/v1

# Own Postgres instance (pgvector). Host port 5433 is mapped to 5432.
AI_DATABASE_HOST=ai-postgres
AI_DATABASE_PORT=5432
AI_DATABASE_USER=jobboard
AI_DATABASE_PASSWORD=jobboard
AI_DATABASE_NAME=job_board_ai_ats

# 32 random bytes, urlsafe base64 (needed only for BYOK provider credentials):
# python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AI_ENCRYPTION_KEY=
# Shared secret the core API sends in X-Internal-Token; must match on both sides.
AI_INTERNAL_TOKEN=

# --- Embedding model (swappable) ----------------------------------------------
# The model and its vector size are configuration. Changing the size also needs
# an Alembic migration (ALTER COLUMN ... TYPE vector(N) + rebuild the HNSW
# index) and a re-embed via `app/scripts/convert_embeddings.py`.
# multilingual-e5-small: 384 dimensions, 100 languages.
AI_LOCAL_EMBEDDING_MODEL=multilingual-e5-small
AI_EMBEDDING_DIM=384
# The local server that serves the embeddings (OpenAI-compatible). Leave empty
# to use a stored OpenAI credential instead. The default matches the llama.cpp
# server started by back-end/ai-platform/scripts/start-llama-servers.ps1.
AI_EMBEDDING_BASE_URL=http://localhost:9932/v1
# E5-style models expect an asymmetric prefix: the job description is a query,
# the resume passages are passages.
AI_EMBEDDING_QUERY_PREFIX=query: 
AI_EMBEDDING_PASSAGE_PREFIX=passage: 

# --- OCR (Tesseract) ----------------------------------------------------------
# The Tesseract language packs installed in the image. English only for now;
# adding a language means installing its pack (see the ai-platform README).
AI_OCR_LANGUAGES=eng
AI_OCR_PAGE_CHAR_THRESHOLD=40

# --- Local chat model (OpenAI-compatible, no API key) -------------------------
# The model server runs on the host. Host-run services use
# http://localhost:<port>/v1; inside Docker the compose overlay overrides it
# with http://host.docker.internal:<port>/v1.
# The defaults match the llama.cpp servers started by
# back-end/ai-platform/scripts/start-llama-servers.ps1 (or .sh).
AI_LOCAL_LLM_BASE_URL=http://localhost:9931/v1
AI_LOCAL_LLM_MODEL=local-chat
AI_LOCAL_LLM_API_KEY=
# One local call is bounded: a CPU model is slow and its context is small.
# These limits apply to the local route only; a paid provider keeps its own.
AI_LOCAL_LLM_TIMEOUT_SECONDS=180
AI_LOCAL_LLM_MAX_INPUT_CHARS=8000
AI_LOCAL_LLM_MAX_TOKENS=900
AI_LOCAL_LLM_TEMPERATURE=0

# --- RabbitMQ (shared broker) ------------------------------------------------
RABBITMQ_USER=jobboard
RABBITMQ_PASSWORD=jobboard
RABBITMQ_VHOST=/
# Inside Compose the host is the service name; both APIs read these.
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# Core API outbox relay: how many unpublished records one tick publishes, how
# often it looks, and how many failed publishes mark a record as dead.
RABBITMQ_OUTBOX_BATCH_SIZE=50
RABBITMQ_OUTBOX_POLL_MS=5000
RABBITMQ_MAX_PUBLISH_ATTEMPTS=5
