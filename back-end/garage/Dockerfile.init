# The Garage image is distroless (no shell), so the one-shot initialiser
# copies the static `garage` binary into a small Alpine image with a shell.
FROM dxflrs/garage:v1.3.1 AS garage

FROM alpine:3.20

RUN apk add --no-cache ca-certificates

COPY --from=garage /garage /garage
COPY garage-init.sh /garage-init.sh

# The repository is checked out with the line endings of the machine, so on
# Windows this file arrives with CRLF. The shell would read `set -eu\r` and
# die with "illegal option -", so the carriage returns go here, in the image.
RUN sed -i 's/\r$//' /garage-init.sh && chmod +x /garage-init.sh

ENTRYPOINT ["/bin/sh", "/garage-init.sh"]
