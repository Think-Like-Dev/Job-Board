# ─────────────────────────────────────────────────────────────────────────────
# Job Board Platform API — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` (for local dev) or `.env.<NODE_ENV>` (e.g.
# `.env.staging`, `.env.production`) and adjust the values.
#
# Loading order (see src/app.module.ts):
#   `.env.<NODE_ENV>` first, then `.env`.
# NODE_ENV therefore determines BOTH the runtime mode AND which env file is
# loaded, i.e. the app's run-time profile is driven entirely by env config.
#
# All values have safe defaults baked into src/config/configuration.ts, so a
# missing variable falls back to the default listed below.
# ─────────────────────────────────────────────────────────────────────────────

# ─── App / runtime ───────────────────────────────────────────────────────────
# Runtime mode. Controls which `.env.<NODE_ENV>` file is loaded and is used as
# the `nodeEnv` config value. Use: local | staging | production
NODE_ENV=local

# HTTP port the API listens on (default: 5000)
PORT=5000

# Global URL prefix for all routes, e.g. `/api/...` (default: api)
API_PREFIX=api

# Comma-separated list of allowed CORS origins for browser clients
# (default: http://localhost:5173,http://localhost:5174)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ─── PostgreSQL (source of truth for relational data) ────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=thinklikedev
# Set locally; never commit a real password.
DATABASE_PASSWORD=change-me
DATABASE_NAME=job_board

# ─── Redis (central auth store: OTP codes + login sessions) ──────────────────
# Sessions and OTPs live ONLY in Redis (never in Postgres). See README/compose.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Namespace prefix prepended to every Redis key (default: jobboard:)
REDIS_KEY_PREFIX=jobboard:

# ─── Authentication: sessions ────────────────────────────────────────────────
# Session lifetime in minutes. Drives both the Redis session TTL and the
# session cookie max-age (default: 10080 = 7 days)
SESSION_EXPIRY_MINUTES=10080
# Name of the HttpOnly session cookie (default: session_token)
SESSION_COOKIE_NAME=session_token
# Send the cookie over HTTPS only. Must be "true" in production.
# (default: false)
COOKIE_SECURE=false
# SameSite policy for the session cookie: lax | strict | none
# (default: lax)
COOKIE_SAME_SITE=lax

# ─── Seed data ───────────────────────────────────────────────────────────────
# Password assigned to the seeded admin/recruiter/hiring-manager users.
# Required outside local; local defaults to ChangeMe123! when unset.
SEED_DEFAULT_PASSWORD=ChangeMe123!

# ─── Authentication: OTP ─────────────────────────────────────────────────────
# OTP code TTL in seconds (default: 300 = 5 min)
OTP_EXPIRY_SECONDS=300
# Development-only fixed OTP so the UI can be tested without an email server.
# Only used when NODE_ENV=local (default: 123456). Ignored in staging/production.
DEV_FIXED_OTP=123456

# ─── Mail (SMTP) ─────────────────────────────────────────────────────────────
# Local development uses Mailpit: SMTP on 1025, inbox at http://localhost:8025.
# Inside Compose the host is the `mailpit` service; the local overlay sets it.
# Staging and production use a real relay's host and credentials.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@jobboard.local
# Public URL of the recruiter SPA, used in emailed links (invites, reset).
RECRUITER_APP_URL=http://localhost:5173
# Password reset link lifetime, in minutes (default: 30).
PASSWORD_RESET_EXPIRY_MINUTES=30

# ─── Object storage (Garage S3) ──────────────────────────────────────────────
# Endpoint as seen from the API process. Inside Compose this is
# http://garage:3900; when running the API on the host use
# http://localhost:3900.
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
# Access key created by garage-init. Never commit real credentials.
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_BUCKET_NAME=jobboard-files
S3_FORCE_PATH_STYLE=true
# Presigned download URL lifetime in seconds (default: 900 = 15 min).
S3_SIGNED_URL_EXPIRY_SECONDS=900

# ─── RabbitMQ (shared event broker) ─────────────────────────────────────────
# Same idea as the datastores: the host view is localhost + the published
# ports; the compose overlay supplies the service name `rabbitmq`.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=jobboard
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=/
# Outbox relay tuning (defaults match src/config).
RABBITMQ_OUTBOX_POLL_MS=1000
RABBITMQ_OUTBOX_BATCH_SIZE=50
RABBITMQ_MAX_PUBLISH_ATTEMPTS=5

# ─── AI platform ────────────────────────────────────────────────────────────
# Shared secret the AI service expects in X-Internal-Token. Must match
# AI_INTERNAL_TOKEN in back-end/env/.env.<environment>.
AI_INTERNAL_TOKEN=change-me
