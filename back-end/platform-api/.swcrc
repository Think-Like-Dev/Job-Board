{
  "$schema": "https://swc.rs/schema.json",
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "decorators": true
    },
    "target": "es2023",
    "baseUrl": "./",
    "paths": {
      "@src/*": ["./src/*"],
      "@common/*": ["./src/common/*"],
      "@modules/*": ["./src/modules/*"]
    },
    "experimental": {
      "keepImportAttributes": false
    }
  },
  "module": {
    "type": "commonjs"
  }
}
